# =============================================================================
# 3i Sales Funnel — server env (Mobility / Biogas_MIS style)
# Copy to server/.env and set DB credentials.
# Never commit server/.env
# =============================================================================

PORT=4090
HOST=0.0.0.0
NODE_ENV=development

# Production: Express serves built SPA from ../client/out on the same PORT
# Build first:  cd client && npm ci && npm run build
SERVE_CLIENT=true

FRONTEND_URL=http://localhost:4090
PUBLIC_APP_URL=http://localhost:4090
CLIENT_ORIGIN=http://localhost:4090,http://localhost:5173
FORCE_HTTPS=false

# --- Database (new schema — do not reuse Mobility_ITAssetManagement_2026) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=3i_Sales_funnel
DB_USER=raghul
DB_PASSWORD=change_me

JWT_SECRET=change_this_to_a_secure_random_string

# --- Email (optional — forgot-password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="3i Sales Funnel" <noreply@example.com>
